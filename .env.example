# Wispr Flow analysis configuration. Copy to .env and edit.

# Path to Wispr Flow's live SQLite. Default is the macOS install path.
# FLOW_SQLITE_PATH=/Users/yourname/Library/Application Support/Wispr Flow/flow.sqlite

# Where to put the read-only working copy.
# SNAPSHOT_PATH=./data/snapshot.sqlite

# Local timezone offset in minutes. -240 = Eastern Daylight, -300 = Eastern Standard,
# -480 = Pacific Standard, 0 = UTC.
LOCAL_TZ_OFFSET_MINUTES=-240

# The two-voices analysis compares dictation aimed at models against dictation
# aimed at people. It reports zero words if none of your apps are in either
# set, so check these against your own corpus. Run scripts/analytics.py once
# and read the per_app block in outputs/analytics.json to list your bundle IDs.
# Comma-separated. Setting one of these replaces the default set, it does not
# add to it.
# AI_FACING_APPS=com.todesktop.230313mzl4w4u92,com.microsoft.VSCode,com.anthropic.claudefordesktop,com.openai.codex
# HUMAN_FACING_APPS=com.tinyspeck.slackmacgap,com.hnc.Discord,net.whatsapp.WhatsApp,com.apple.MobileSMS,com.tdesktop.Telegram

# ---------------------------------------------------------------------------
# LLM provider. Configure either Azure OpenAI or Anthropic. Azure is preferred
# if both are present.
# ---------------------------------------------------------------------------

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# Anthropic (fallback). Optional.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
